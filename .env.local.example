# このファイルをコピーして .env.local という名前で保存し、
# 実際のAPIキーを入力してください。
# .env.local はGitに含まれないので、絶対にこのファイル(.example)には
# 本物のキーを書かないでください。

# Google AI Studio (https://aistudio.google.com) で発行したキー
GEMINI_API_KEY=ここに取得したAPIキーを貼り付ける

# 将来他のAIプロバイダーに切り替える場合に使う想定の変数(今は未使用でOK)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# どのAIプロバイダーを使うか。今は "gemini" 固定でOK
AI_PROVIDER=gemini
